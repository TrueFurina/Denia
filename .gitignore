# ============================================================
# 达妮娅 AI 桌面伴侣 · 版本控制排除规则
# 原则：Runtime / 构建产物 / 含真实密钥的配置 / 用户隐私数据 一律不入库
# ============================================================

# ---- 运行环境（体积大、可重建）----
.venv/
python/
venv/
__pycache__/
*.py[cod]
*.pyd
*.pyo
*$py.class

# ---- 构建产物 ----
*.exe
*.msi
build/
dist/
# 打包时的暂存目录（dist_stage / dist_core / dist_v2 …），与 dist/ 同等对待
dist_*/
*.spec
ort_dml/

# ---- 敏感配置：含真实 API Key，严禁入库 ----
# config.release.yaml 是发布模板，可入库；config.yaml 是实配，不入库
config.yaml
config.local.yaml
.env
.env.*
secrets*.yaml
*.key
*.pem

# ---- 用户隐私数据 ----
data/
call_records.json
logs/
*.log
src/ui/web/assets/chat_audio/
user_knowledge.yaml
*.swapbak_*

# ---- 临时/诊断产物 ----
.workbuddy/
tools/_*_out*.txt
tools/_*.jsonl
tools/_*.txt
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.tmp
*.bak

# Electron 壳 PoC：只提交源码，不提交 300MB 的二进制依赖
shell/node_modules/
shell/dist/
shell/out/
# 诊断脚本产出的截图（每次运行都会变，不入库）
tools/_*.png

# NSIS 构建工具链（本地下载，不进版本库；构建入口 tools/installer.nsi）
.build_tools/

# 贴纸技能的素材包（67MB 图片，本地产物，不进仓库）
tools/daniya_sticker_skill/data/

# 智能体工作目录（项目记忆/会话数据，本地留存，不入库）
.workbuddy-ai/

# 真机探针产物（tools/_qc_setup_hint.py 每次跑都会重画）
/_qc_*.png

# 个人数据归档/回收暂存（含历史对话/记忆/配置，严禁入库）
archive_daniya_20261102/
.trash/
